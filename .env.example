# =====================================================================
# TRÔNE Seating — environment. Kopieer naar .env.local (niet committen).
# Runtime gebruikt losse host-vars (MariaDB-adapter). DATABASE_URL is
# alleen voor de Prisma CLI (migrations).
# =====================================================================

# --- MariaDB SkySQL (runtime) ---
DATABASE_HOST=your-service.mariadb.skysql.com
DATABASE_PORT=3306
DATABASE_NAME=trone_seating
DATABASE_USER=trone_app
DATABASE_PASSWORD=change-me
DATABASE_ENV=development            # development | test | production

# --- Prisma CLI / migrations only ---
DATABASE_URL="mysql://trone_app:change-me@your-service.mariadb.skysql.com:3306/trone_seating?ssl=true"

# --- Better Auth (interne gebruikers) ---
BETTER_AUTH_SECRET=generate-32-byte-base64
# Lokaal: http://localhost:3000
# Productie (Vercel): https://www.troneseating.app
BETTER_AUTH_URL=http://localhost:3000

# --- Mail (Resend) ---
RESEND_API_KEY=
# Optioneel. Standaard: TRÔNE | CRM <mail@updates.troneseating.app>
RESEND_FROM_EMAIL=TRÔNE | CRM <mail@updates.troneseating.app>
RESEND_REPLY_TO_EMAIL=info@troneseating.nl
# Optioneel. Publieke origin voor het logo in e-mails (niet localhost).
# MAIL_ASSET_ORIGIN=https://www.troneseating.app

# --- Mollie (facturatie) ---
MOLLIE_API_KEY=

# --- Vercel Blob (swatches en productafbeeldingen) ---
# Token: Vercel-dashboard → Storage → Blob → je store → tab ".env.local".
# Of: Project → Settings → Environment Variables, nadat Blob is gekoppeld.
BLOB_READ_WRITE_TOKEN=

# --- Eenmalige bootstrap admin (optioneel) ---
# Vul in en draai: pnpm auth:create-admin
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=
